# 服务端口
PORT=8787

# 数据库驱动：sqlite（默认，零配置）| postgres（推荐生产，可填 Supabase 的 Postgres 连接串）
DB_DRIVER=sqlite

# sqlite 模式的数据文件路径
DB_FILE=./data/guobao.db

# postgres 模式的连接串（DB_DRIVER=postgres 时必填）
# Supabase 控制台 → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[密码]@db.xxxx.supabase.co:5432/postgres

# 数据统计接口的管理口令（务必改成自己的长随机串）
ADMIN_TOKEN=change-me-please

# 允许的前端来源，多个用逗号分隔；线上建议填 GitHub Pages 域名
CORS_ORIGIN=*

# 首次启动是否写入示例测评码（true/false）
SEED_DEFAULT=true
